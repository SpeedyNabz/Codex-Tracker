{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Tracker",
  "version": "0.1.0",
  "identifier": "com.heavymask.codex-usage-overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Tracker · HeavyMask",
        "width": 300,
        "height": 188,
        "minWidth": 300,
        "maxWidth": 300,
        "minHeight": 120,
        "maxHeight": 520,
        "resizable": false,
        "fullscreen": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Heavymask",
    "homepage": "https://heavymask.com",
    "copyright": "Made by HeavyMask · https://heavymask.com",
    "category": "Utility",
    "shortDescription": "Live Codex allowance tracker by HeavyMask",
    "longDescription": "Track Codex allowance percentages, reset times, token activity, and credits from a compact desktop app for Windows, macOS, and Linux. Made by HeavyMask: https://heavymask.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp"
      }
    }
  }
}
